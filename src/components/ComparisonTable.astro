---
/**
 * "Us vs the national chains" table. The single highest-intent block on a
 * local installer home page: it is the argument the customer is already
 * having in their head after the big-brand salesman left.
 *
 * Config: business.comparison = {
 *   heading?, them?: 'National chains', rows: [{ label, us, them }]
 * }
 * Every row must be a claim the client can defend — never tick a box for
 * something they do not actually do. Template style: ink header, brand "us"
 * column with a tick, a cross where the other side's answer is a flat no.
 */
import { site } from '../lib/client.mjs';

const c = site.business.comparison;
const rows = c?.rows ?? [];
const themLabel = c?.them ?? 'National chains';
const usLabel = site.business.name;
const isNo = (v) => /^(no|rare|rarely|not|never)\b/i.test(String(v ?? '').trim());
---
{rows.length > 0 && (
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Straight comparison</p>
        <h2>{c.heading ?? 'Why local homeowners choose us over the rest'}</h2>
      </div>
      <div class="cmp">
        <table>
          <thead>
            <tr>
              <th scope="col">What matters to you</th>
              <th scope="col" class="cmp__us">{usLabel}</th>
              <th scope="col">{themLabel}</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td class="cmp__us"><span aria-hidden="true">✓&nbsp;</span>{r.us}</td>
                <td class:list={['cmp__them', isNo(r.them) && 'cmp__no']}>{isNo(r.them) && <span aria-hidden="true">✗&nbsp;</span>}{r.them}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
)}

<style>
  .cmp { max-width: 56rem; overflow-x: auto; border: 1px solid var(--hairline); border-radius: var(--radius-lg); background: #fff; }
  table { width: 100%; border-collapse: collapse; min-width: 35rem; font-size: 0.95rem; }
  th, td { text-align: left; padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--hairline); }
  thead th { font-family: var(--font-heading); font-weight: 600; font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; background: var(--ink); color: #fff; border-bottom: 0; }
  thead th.cmp__us { background: var(--brand); }
  tbody th { font-weight: 500; color: var(--ink); }
  td.cmp__us { background: var(--brand-tint); color: var(--brand-dark); font-weight: 600; }
  .cmp__them { color: var(--ink); }
  .cmp__no { color: var(--muted); }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
</style>
