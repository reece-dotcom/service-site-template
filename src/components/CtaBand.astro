---
import { site } from '../lib/client.mjs';
const {
  heading = 'Ready for a straight-talking quote?',
  text = 'No pressure, no sales patter — a proper survey and a fixed price in writing.',
  callLabel,
  ghostLabel = 'Request a callback',
  ghostHref = '/contact/',
  ghostLang,
} = Astro.props;
---
<section class="cta section">
  <div class="container cta__inner">
    <div>
      <h2>{heading}</h2>
      <p class="cta__p">{text}</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--accent" href={`tel:${site.contact.phoneHref}`}>
        {callLabel ?? `Call ${site.contact.phone}`}
      </a>
      <a class="btn btn--ghost cta__ghost" href={ghostHref} lang={ghostLang}>{ghostLabel}</a>
    </div>
  </div>
</section>
<style>
  .cta {
    background:
      radial-gradient(120% 140% at 92% 0%, color-mix(in srgb, var(--brand) 62%, transparent) 0%, transparent 62%),
      var(--brand-dark);
    color: #fff; border-top: 3px solid var(--accent);
  }
  .cta :global(h2) { max-width: 24ch; }
  .cta__inner { display: flex; gap: var(--space-8); align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .cta__p { opacity: 0.88; margin-top: var(--space-3); max-width: 46ch; }
  .cta__actions { display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .cta__ghost { color: #fff; }
  .cta__ghost:hover { color: var(--accent-on-dark); }
</style>
