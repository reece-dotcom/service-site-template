---
/**
 * Strip above the header on prospect demos only. Says plainly that this is a
 * preview and links the demo and the Lighthouse Review to each other.
 */
import { site } from '../lib/client.mjs';
import { hasLighthouse, agency } from '../lib/demo.mjs';
const onReview = Astro.url.pathname.startsWith('/lighthouse');
const review = hasLighthouse();
---
<div class="demo-bar">
  <div class="container demo-bar__in">
    <p>Preview built for <strong>{site.business.name}</strong> by {agency().name} — not live, not on Google.</p>
    {review && (onReview
      ? <a href="/">Look around your demo site &rarr;</a>
      : <a href="/lighthouse/">Read your Lighthouse Review &rarr;</a>)}
  </div>
</div>
<style>
  .demo-bar { background: var(--ink); color: #fff; font-size: 0.9rem; }
  .demo-bar__in { display: flex; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-2); flex-wrap: wrap; align-items: center; }
  .demo-bar p { opacity: 0.85; }
  .demo-bar a { color: var(--accent-on-dark); font-weight: 650; text-decoration: none; white-space: nowrap; }
  .demo-bar a:hover { text-decoration: underline; }
  @media print { .demo-bar { display: none; } }
</style>
