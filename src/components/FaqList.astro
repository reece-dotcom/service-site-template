---
// Headings are overridable so translated pages are not stuck with English
// furniture around Welsh content.
const { faqs, eyebrow = 'Common questions', heading = 'Answered honestly' } = Astro.props;
---
{faqs?.length ? (
  <section class="section section--surface">
    <div class="container">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{heading}</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
) : null}
<style>
  .faq { margin-top: var(--space-8); max-width: 60rem; }
  .faq__item { background: #fff; border-radius: var(--radius); padding: var(--space-4) var(--space-6); border: 1px solid color-mix(in srgb, var(--muted) 20%, transparent); }
  .faq__item + .faq__item { margin-top: var(--space-3); }
  .faq__item summary { font-weight: 650; cursor: pointer; font-family: var(--font-heading); font-size: 1.05rem; }
  .faq__item p { margin-top: var(--space-3); color: var(--muted); }
</style>
