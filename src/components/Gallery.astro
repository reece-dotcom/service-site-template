---
/**
 * Recent-work gallery. Renders nothing when the client has no images, so a
 * text-only build stays valid.
 */
import { Image } from 'astro:assets';
import { clientImages } from '../lib/images.mjs';

const { items = [], heading = 'Recent work', eyebrow = 'The results' } = Astro.props;
const shots = clientImages(items);
---
{shots.length ? (
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{eyebrow}</p>
          <h2>{heading}</h2>
        </div>
        <p class="lede">Real jobs, photographed as they were finished — no stock imagery.</p>
      </div>
      <div class="gal">
        {shots.map((s) => (
          <figure class="gal__item">
            <Image src={s.asset} alt={s.alt} widths={[420, 760]} sizes="(max-width: 48rem) 92vw, 32vw" loading="lazy" />
            {s.caption && <figcaption>{s.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  </section>
) : null}
<style>
  .gal { display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); }
  .gal__item { margin: 0; display: flex; flex-direction: column; }
  .gal__item img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-lg); display: block; }
  .gal__item figcaption {
    margin-top: var(--space-4); color: var(--muted); font-size: 0.92rem;
    padding-left: var(--space-4); border-left: 2px solid var(--accent);
  }
</style>
