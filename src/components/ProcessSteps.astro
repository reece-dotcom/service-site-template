---
/**
 * "How it works" strip. Steps come from business.process in site.config.mjs;
 * the fallback suits any trade that surveys before quoting.
 */
import { site } from '../lib/client.mjs';

const steps = site.business.process?.length
  ? site.business.process
  : [
      { title: 'Call or message', body: 'Tell us what the problem is. Most jobs we can price sensibly over the phone.' },
      { title: 'We look at it properly', body: 'We check the whole thing, not just the bit that failed, so it does not come back.' },
      { title: 'Fixed price in writing', body: 'You get a price that does not move, and a date. No sales visit, no discount theatre.' },
    ];
---
<section class="section section--surface">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">How it works</p>
        <h2>Three steps, no sales visit</h2>
      </div>
      <p class="lede">Nobody sits in your front room for two hours. You get a price, a date, and the work done.</p>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="steps__item">
          <span class="steps__num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .steps { list-style: none; padding: 0; display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .steps__item { background: #fff; border-radius: var(--radius-lg); padding: var(--space-6); border: 1px solid var(--hairline); border-top: 3px solid var(--brand); position: relative; }
  .steps__num { font-family: var(--font-heading); font-weight: 700; color: var(--brand); font-size: 2.4rem; opacity: 0.9; line-height: 1; letter-spacing: -0.03em; display: block; }
  .steps__item h3 { margin-top: var(--space-3); font-size: 1.15rem; }
  .steps__item p { margin-top: var(--space-2); color: var(--muted); font-size: 0.95rem; }
</style>
