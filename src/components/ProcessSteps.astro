---
/**
 * "The five things that happen, in order." Numbered circles joined by a line,
 * template style. Steps come from business.process; the default is the
 * template's five for a replacement installer, with the FENSA line only when
 * the client actually holds a competent-person registration.
 */
import { site } from '../lib/client.mjs';
import { accreditationNames } from '../lib/business.mjs';

const scheme = accreditationNames().find((n) => /fensa|certass|assure/i.test(n));
const registration = scheme ? `${scheme.split(' ')[0]}` : null;
const steps = site.business.process?.length
  ? site.business.process
  : [
      { title: 'Survey', body: 'Every opening measured properly, plus a look at lintels, sills and anything the last fitter got wrong.' },
      { title: 'Fixed price', body: 'In writing, itemised per opening. No pressure discount attached to it.' },
      { title: 'Manufacture', body: 'Made to your measurements. Frame colour and glass spec confirmed in writing before anything is cut.' },
      { title: 'Fit day', body: 'Dust sheets down, old units out, new ones in, everything sealed and the waste taken away. The house is watertight every night.' },
      { title: 'Sign-off', body: registration ? `We walk the job with you, adjust anything stiff, then register it with ${registration}. Your certificate follows in the post.` : 'We walk the job with you, adjust anything stiff, and hand over the guarantee paperwork.' },
    ];
const heading = site.business.processHeading ?? `The ${['one', 'two', 'three', 'four', 'five', 'six'][steps.length - 1] ?? steps.length} things that happen, in order.`;
---
<section class="section section--surface">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">How it works</p>
      <h2>{heading}</h2>
      <p class="lede">Nobody phones you afterwards to renegotiate. The number on the quote is the number on the invoice.</p>
    </div>
    <ol class:list={['steps', `steps--n${steps.length}`]}>
      {steps.map((s, i) => (
        <li class="step">
          <span class="step__n" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: clamp(1.1rem, 2vw, 1.6rem); }
  .steps--n3 { grid-template-columns: repeat(3, 1fr); }
  .steps--n4 { grid-template-columns: repeat(4, 1fr); }
  .step { position: relative; }
  .step__n { font-family: var(--font-heading); font-weight: 600; font-size: 0.9rem; width: 2.4rem; height: 2.4rem; border-radius: 50%; display: grid; place-items: center; background: var(--brand); color: #fff; margin-bottom: 1rem; position: relative; z-index: 1; box-shadow: 0 0 0 6px var(--surface); }
  .step:not(:last-child)::before { content: ''; position: absolute; top: 1.2rem; left: 2.4rem; right: calc(-1 * clamp(1.1rem, 2vw, 1.6rem)); height: 2px; background: var(--hairline-2); }
  .step h3 { font-size: 1.05rem; margin-bottom: 0.4rem; }
  .step p { font-size: 0.92rem; color: var(--muted); line-height: 1.6; }
  @media (max-width: 56rem) {
    .steps, .steps--n3, .steps--n4 { grid-template-columns: 1fr; gap: 1.5rem; }
    .step { padding-left: 3.5rem; }
    .step__n { position: absolute; left: 0; top: -0.25rem; margin: 0; }
    .step:not(:last-child)::before { top: 2.4rem; bottom: -1.75rem; left: 1.15rem; right: auto; width: 2px; height: auto; }
  }
</style>
