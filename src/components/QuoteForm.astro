---
/**
 * The single lead form used everywhere (hero, contact page). Server-side POST,
 * no client JS. Keep one implementation — two diverging forms means one of
 * them quietly stops posting to the CRM.
 */
import { site } from '../lib/client.mjs';

const { compact = false, heading = 'Request a callback', id = 'quote-form' } = Astro.props;
const useGhl = site.forms.provider === 'ghl';
/**
 * Qualifying dropdown. Options come from business.enquiryOptions so the CRM
 * gets a routed, categorised lead instead of free text. Omit the field
 * entirely rather than shipping a generic list that does not match what the
 * client sells.
 */
const enquiryOptions = site.business.enquiryOptions ?? [];
/** "George will call you back" — a named human beats "we will be in touch". */
const owner = site.business.owner?.name?.split(' ')[0];
const action = useGhl ? site.forms.ghlEndpoint : '/thank-you/';
---
<div class:list={['qf', compact && 'qf--compact']} id={id}>
  <h2 class="qf__h">{heading}</h2>
  <p class="qf__sub muted">
    {owner
      ? `${owner} will call you back to arrange a free survey. No pressure and no sales patter.`
      : 'No pressure and no sales patter — just a straight answer.'}
  </p>
  <form
    class="form"
    method="POST"
    action={action}
    name={useGhl ? undefined : 'quote'}
    data-netlify={useGhl ? undefined : 'true'}
  >
    {!useGhl && <input type="hidden" name="form-name" value="quote" />}
    {useGhl && site.forms.ghlLocationId && (
      <input type="hidden" name="location_id" value={site.forms.ghlLocationId} />
    )}
    <p class="visually-hidden">
      <label>Leave this blank if you are human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>
    <div class="form__row">
      <label class="field">
        <span>Your name</span>
        <input type="text" name="full_name" autocomplete="name" required />
      </label>
      <label class="field">
        <span>Phone</span>
        <input type="tel" name="phone" autocomplete="tel" required />
      </label>
    </div>
    <div class="form__row">
      <label class="field">
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label class="field">
        <span>Postcode</span>
        <input type="text" name="postal_code" autocomplete="postal-code" required />
      </label>
    </div>
    {enquiryOptions.length > 0 && (
      <label class="field">
        <span>What do you need?</span>
        <select name="enquiry_type" required>
          <option value="">Choose one…</option>
          {enquiryOptions.map((o) => <option value={o}>{o}</option>)}
        </select>
      </label>
    )}
    <label class="field">
      <span>What needs doing?</span>
      <textarea name="message" rows={compact ? 3 : 4} required></textarea>
    </label>
    <button class="btn btn--accent form__btn" type="submit">Get my quote</button>
    <p class="form__note muted">We&rsquo;ll only use your details to arrange your quote.</p>
  </form>
</div>
<style>
  .qf { color: var(--ink); background: #fff; border-radius: var(--radius-panel); padding: clamp(1.4rem, 2.4vw, 1.75rem); border: 1px solid var(--hairline); box-shadow: var(--shadow); }
  .qf__h { color: var(--ink); font-size: 1.25rem; }
  .qf__sub { font-size: 0.9rem; margin-top: var(--space-2); }
  .form { display: grid; gap: var(--space-4); margin-top: var(--space-5); }
  .form__row { display: grid; gap: var(--space-4); grid-template-columns: 1fr 1fr; }
  .field { color: var(--ink); display: grid; gap: 0.4rem; font-weight: 600; font-size: 0.86rem; }
  .field input, .field textarea, .field select {
    font: inherit; font-weight: 400; font-size: 1rem; padding: 0.65rem 0.875rem; border-radius: var(--radius-sm);
    border: 1px solid var(--hairline-2); background: var(--surface); width: 100%; color: var(--ink);
  }
  .field input:focus, .field textarea:focus, .field select:focus {
    outline: none; border-color: var(--brand); background: #fff;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--brand) 12%, transparent);
  }
  .form__btn { width: 100%; }
  .form__note { font-size: 0.8rem; }
  @media (max-width: 40rem) { .form__row { grid-template-columns: 1fr; } }
</style>
