---
/**
 * Google reviews grid (template: centred "4.9 out of 5 · 312 reviews" line,
 * three quote cards). Only renders when reviews.featured is populated — and
 * only ever with reviews actually pulled from the client's Google Business
 * Profile. Never invent a rating: a fabricated 5.0 is the single fastest way
 * to lose trust with a prospect who knows their own review count.
 */
import { site } from '../lib/client.mjs';

const agg = site.reviews?.aggregate ?? null;
const featured = (site.reviews?.featured ?? []).slice(0, 3);
const profileUrl = site.reviews?.profileUrl ?? '';
---
{featured.length > 0 && (
  <section class="rv">
    <div class="container">
      <p class="rv__head">
        <img src="/logos/google.png" alt="Google" />
        {agg ? <><b>{agg.ratingValue}</b> out of 5 · {agg.reviewCount} {agg.source ?? 'Google'} reviews</> : <span>What customers say on Google</span>}
        {profileUrl && <a class="rv__link" href={profileUrl} target="_blank" rel="noopener">Read them all</a>}
      </p>
      <ul class="rv__grid">
        {featured.map((r) => (
          <li class="rv__card">
            <p class="rv__stars" aria-label={`${r.rating ?? 5} out of 5`}>★★★★★</p>
            <blockquote>{r.body}</blockquote>
            <cite>{r.author}, posted on {r.source ?? agg?.source ?? 'Google'}{r.when ? ` · ${r.when}` : ''}</cite>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
  .rv { padding-block: clamp(2.75rem, 5vw, 4rem); }
  .rv__head { display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 1.6rem; font-size: 0.95rem; color: var(--muted); flex-wrap: wrap; }
  .rv__head img { height: 1.75rem; width: auto; }
  .rv__head b { font-weight: 700; font-size: 1.25rem; color: var(--ink); }
  .rv__link { font-weight: 600; margin-left: 0.5rem; }
  .rv__grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; }
  .rv__card { border: 1px solid var(--hairline); background: #fff; border-radius: var(--radius-lg); padding: 1.4rem 1.5rem; transition: transform 0.4s var(--ease-out), box-shadow 0.4s; }
  .rv__card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lift); }
  .rv__stars { color: var(--brand); letter-spacing: 2px; font-size: 0.85rem; line-height: 1; }
  .rv__card blockquote { margin: 0.6rem 0 0.75rem; font-size: 0.98rem; line-height: 1.6; color: var(--ink); }
  .rv__card cite { font-style: normal; font-size: 0.85rem; color: var(--muted); font-weight: 500; }
  @media (max-width: 54rem) { .rv__grid { grid-template-columns: 1fr; } }
</style>
