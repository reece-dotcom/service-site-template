---
import { site } from '../lib/client.mjs';
import { accreditationNames } from '../lib/business.mjs';
import { getCollection } from 'astro:content';
const areas = (await getCollection('areas')).filter((a) => !a.data.draft);
const services = (await getCollection('services')).filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const a = site.contact.address;
const year = new Date().getFullYear();
// Social profiles the client has confirmed exist. Rendered as real links so
// visitors (and Google) can see the business is active somewhere off-site;
// the same list feeds sameAs in the schema.
const socialLabels = { facebook: 'Facebook', instagram: 'Instagram', x: 'X', linkedin: 'LinkedIn', youtube: 'YouTube' };
const socials = Object.entries(site.social ?? {})
  .filter(([, url]) => Boolean(url))
  .map(([key, url]) => ({ url, label: socialLabels[key] ?? key }));
---
<footer class="ftr">
  <div class="container grid grid--3">
    <div>
      <h2 class="ftr__h">{site.business.name}</h2>
      <p class="ftr__p">{site.business.tagline}</p>
      <address class="ftr__p ftr__addr">
        {a.street}<br />{a.locality}<br />{a.region} {a.postcode}
      </address>
      <p class="ftr__p">
        <a href={`tel:${site.contact.phoneHref}`}>{site.contact.phone}</a><br />
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </p>
      {socials.length > 0 && (
        <p class="ftr__p ftr__social">
          {socials.map((s2) => (
            <a href={s2.url} rel="me noopener" target="_blank">{s2.label}</a>
          ))}
        </p>
      )}
    </div>
    <div>
      <h2 class="ftr__h">Services</h2>
      <ul class="ftr__list">
        {services.map((s) => <li><a href={`/services/${s.id}/`}>{s.data.name}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="ftr__h">Areas we cover</h2>
      <ul class="ftr__list">
        {areas.map((x) => <li><a href={`/areas/${x.id}/`}>{x.data.name}</a></li>)}
        <li><a href="/about/">About us</a></li>
        <li><a href="/blog/">Advice &amp; guides</a></li>
        <li><a href="/contact/">Get a quote</a></li>
      </ul>
    </div>
  </div>
  <div class="container ftr__base">
    <p>&copy; {year} {site.business.legalName}. {accreditationNames().join(' · ')}</p>
  </div>
</footer>
<style>
  .ftr { background: var(--ink); color: #fff; padding-block: var(--space-16) var(--space-8); margin-top: var(--space-16); }
  .ftr a { color: #fff; }
  .ftr a:hover { color: var(--accent-on-dark); text-decoration-thickness: 2px; }
  .ftr__h { font-size: 1rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--space-4); color: var(--accent-on-dark); }
  .ftr__p { opacity: 0.85; margin-bottom: var(--space-4); font-size: 0.98rem; }
  .ftr__addr { font-style: normal; }
  .ftr__list { list-style: none; padding: 0; display: grid; gap: var(--space-2); font-size: 0.98rem; }
  .ftr__social { display: flex; gap: var(--space-4); }
  .ftr__base { margin-top: var(--space-12); padding-top: var(--space-6); border-top: 1px solid rgb(255 255 255 / 18%); font-size: 0.875rem; opacity: 0.7; }
</style>
