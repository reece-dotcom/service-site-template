---
import { site } from '../lib/client.mjs';
import { Image } from 'astro:assets';
import { clientImage } from '../lib/images.mjs';
/** Optional client logo (site.media.logo). Falls back to the business name in text. */
const logo = clientImage(site.media?.logo);
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/areas/', label: 'Areas we cover' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Advice' },
  { href: '/contact/', label: 'Contact' },
];
const isCurrent = (href) => (href === '/' ? path === '/' : path.startsWith(href));
/** Link to this page's other-language twin, supplied by BaseLayout. */
const { switcher, navOverride, callLabel } = Astro.props;
const items = navOverride ?? nav;
---
<header class="hdr">
  <div class="container hdr__inner">
    <a class="hdr__brand" href="/" aria-label={`${site.business.name} — home`}>
      {logo ? <Image class="hdr__logo" src={logo} alt={site.business.name} height={60} densities={[1, 2]} loading="eager" /> : site.business.name}
    </a>
    <nav class="hdr__nav" aria-label="Main">
      <ul>
        {items.map((i) => (
          <li>
            <a href={i.href} lang={i.lang} aria-current={(navOverride ? i.href === path : isCurrent(i.href)) ? 'page' : undefined}>{i.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    {switcher && (
      <a class="hdr__lang" href={switcher.href} lang={switcher.lang} hreflang={switcher.lang} rel="alternate">
        {switcher.label}
      </a>
    )}
    <a class="btn btn--accent hdr__cta" href={`tel:${site.contact.phoneHref}`}>
      {callLabel ?? `Call ${site.contact.phone}`}
    </a>
  </div>
</header>
<style>
  .hdr { border-bottom: 1px solid color-mix(in srgb, var(--muted) 20%, transparent); background: #fff; position: sticky; top: 0; z-index: 20; }
  .hdr__inner { display: flex; align-items: center; gap: var(--space-6); padding-block: var(--space-4); flex-wrap: wrap; }
  .hdr__logo { display: block; height: 60px; width: auto; }
  .hdr__brand { font-family: var(--font-heading); font-weight: 700; font-size: 1.2rem; color: var(--ink); text-decoration: none; margin-right: auto; }
  .hdr__nav ul { display: flex; gap: var(--space-6); list-style: none; padding: 0; margin: 0; flex-wrap: wrap; }
  .hdr__nav a { color: var(--ink); text-decoration: none; font-weight: 550; font-size: 0.98rem; }
  .hdr__nav a[aria-current='page'] { color: var(--brand); text-decoration: underline; }
  .hdr__lang { color: var(--brand); font-weight: 600; font-size: 0.95rem; text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
  .hdr__cta { padding: 0.6rem 1.1rem; font-size: 0.98rem; }
  @media (max-width: 46rem) {
    .hdr__inner { gap: var(--space-3); padding-block: var(--space-3); }
    .hdr__brand { font-size: 1.05rem; }
    .hdr__logo { height: 44px; }
    .hdr__nav {
      order: 3; width: 100%;
      margin-inline: calc(var(--space-4) * -1);
      padding-inline: var(--space-4);
      overflow-x: auto; scrollbar-width: none;
      border-top: 1px solid var(--hairline);
      padding-top: var(--space-3);
    }
    .hdr__nav::-webkit-scrollbar { display: none; }
    .hdr__nav ul { gap: var(--space-5); flex-wrap: nowrap; }
    .hdr__nav a { white-space: nowrap; font-size: 0.92rem; }
    /* The sticky bottom bar already carries the number on mobile — a second
       full-width call button in the header just pushes the hero down. */
    .hdr__lang { color: var(--brand); font-weight: 600; font-size: 0.95rem; text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
  .hdr__cta { display: none; }
  }
</style>
