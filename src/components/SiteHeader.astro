---
/**
 * Site header, in the template's dark style: brand mark + name, nav, phone,
 * pill CTA. Two variants:
 *   default  — solid ink bar, sticky (inner pages)
 *   'hero'   — transparent, sits inside the dark home hero over the photo
 * The optional announcement strip (home.announce) renders above the nav row
 * and goes through the superlative guard in lp.mjs before it can ship.
 */
import { site } from '../lib/client.mjs';
import { Image } from 'astro:assets';
import { clientImage } from '../lib/images.mjs';

const { variant = 'default', announce = null, switcher, navOverride, callLabel } = Astro.props;
const logo = clientImage(site.media?.logo);
const path = Astro.url.pathname;
const nav = [
  { href: '/services/', label: 'Services' },
  { href: '/areas/', label: 'Areas' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Advice' },
  { href: '/contact/', label: 'Contact' },
];
const isCurrent = (href) => path.startsWith(href);
const items = navOverride ?? nav;
const inHero = variant === 'hero';
/* The form lives on the home page (#quote); inner pages send people there via /contact/. */
const quoteHref = Astro.url.pathname === '/' ? '#quote' : '/contact/#quote';
---
{announce && (
  <div class="ann">
    <p>{announce.text}</p>
    {announce.basis && <p class="ann__basis">{announce.basis}</p>}
  </div>
)}
<header class:list={['hdr', inHero && 'hdr--hero']}>
  <div class="container hdr__inner">
    <a class="hdr__brand" href="/" aria-label={`${site.business.name} — home`}>
      {logo ? (
        <Image class="hdr__logo" src={logo} alt={site.business.name} height={44} densities={[1, 2]} loading="eager" />
      ) : (
        <span class="hdr__mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M12 3v18M4 12h16"/></svg>
        </span>
      )}
      <span class="hdr__name">{site.business.name}</span>
    </a>
    <nav class="hdr__nav" aria-label="Main">
      <ul>
        {items.map((i) => (
          <li>
            <a href={i.href} lang={i.lang} aria-current={(navOverride ? i.href === path : isCurrent(i.href)) ? 'page' : undefined}>{i.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="hdr__right">
      {switcher && (
        <a class="hdr__lang" href={switcher.href} lang={switcher.lang} hreflang={switcher.lang} rel="alternate">{switcher.label}</a>
      )}
      <a class="hdr__phone" href={`tel:${site.contact.phoneHref}`}>{callLabel ?? site.contact.phone}</a>
      <a class="btn btn--primary hdr__cta" href={quoteHref}>Get a quote</a>
    </div>
  </div>
</header>
<style>
  .ann { background: var(--brand); color: #fff; text-align: center; padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 500; line-height: 1.5; position: relative; z-index: 3; }
  .ann__basis { font-size: 0.78rem; font-weight: 400; opacity: 0.8; }

  .hdr { background: var(--ink); color: #fff; position: sticky; top: 0; z-index: 20; }
  .hdr--hero { background: transparent; position: relative; z-index: 3; border-bottom: 1px solid rgb(255 255 255 / 14%); }
  .hdr__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); padding-block: 0.85rem; }
  .hdr__brand { display: flex; align-items: center; gap: 0.65rem; font-family: var(--font-heading); font-weight: 700; font-size: 1.15rem; color: #fff; text-decoration: none; letter-spacing: -0.01em; }
  .hdr__mark { width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--brand); display: grid; place-items: center; flex: none; }
  .hdr__mark svg { width: 1.1rem; height: 1.1rem; }
  .hdr__logo { display: block; height: 44px; width: auto; }
  .hdr__nav ul { display: flex; gap: 1.75rem; list-style: none; padding: 0; margin: 0; font-size: 0.97rem; font-weight: 500; }
  .hdr__nav a { color: #fff; text-decoration: none; opacity: 0.88; transition: opacity 0.2s; }
  .hdr__nav a:hover, .hdr__nav a[aria-current='page'] { opacity: 1; }
  .hdr__nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 5px; text-decoration-color: var(--brand-on-dark); }
  .hdr__right { display: flex; align-items: center; gap: 1.25rem; }
  .hdr__phone { color: #fff; font-weight: 600; text-decoration: none; white-space: nowrap; font-size: 0.97rem; }
  .hdr__lang { color: #fff; font-weight: 600; font-size: 0.92rem; text-underline-offset: 3px; white-space: nowrap; }
  .hdr__cta { padding: 0.7rem 1.35rem; font-size: 0.93rem; white-space: nowrap; }
  @media (max-width: 62rem) { .hdr__nav { display: none; } }
  @media (max-width: 35rem) { .hdr__phone { display: none; } .hdr__name { font-size: 1rem; } }
  @media (max-width: 62rem) {
    /* Inner pages still need a way to the sections: a scrolling row under the bar. */
    .hdr:not(.hdr--hero) .hdr__nav { display: block; order: 3; width: 100%; overflow-x: auto; scrollbar-width: none; margin-top: 0.25rem; }
    .hdr:not(.hdr--hero) .hdr__nav::-webkit-scrollbar { display: none; }
    .hdr:not(.hdr--hero) .hdr__nav ul { gap: 1.25rem; flex-wrap: nowrap; }
    .hdr:not(.hdr--hero) .hdr__nav a { white-space: nowrap; font-size: 0.92rem; }
    .hdr:not(.hdr--hero) .hdr__inner { flex-wrap: wrap; row-gap: 0.5rem; }
  }
  @media print { .hdr, .ann { display: none; } }
</style>
