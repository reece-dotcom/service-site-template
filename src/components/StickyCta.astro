---
/**
 * Mobile-only sticky call / quote bar. Most glazing leads come from a phone
 * held one-handed; keep the number permanently thumb-reachable.
 */
import { site } from '../lib/client.mjs';
---
<div class="sticky" aria-label="Contact shortcuts">
  <a class="sticky__call" href={`tel:${site.contact.phoneHref}`}>Call {site.contact.phone}</a>
  <a class="sticky__quote" href="/contact/">Free quote</a>
</div>
<style>
  .sticky { display: none; }

  @media (max-width: 46rem) {
    .sticky {
      display: grid; grid-template-columns: 1fr 1fr; gap: 0;
      position: fixed; inset-inline: 0; bottom: 0; z-index: 40;
      box-shadow: 0 -8px 24px -18px rgba(0,0,0,0.6);
    }
    .sticky a { text-align: center; padding: 0.95rem 0.5rem; font-weight: 650; text-decoration: none; font-size: 0.98rem; }
    .sticky__call { background: var(--accent); color: #14211f; }
    .sticky__quote { background: var(--brand-dark); color: #fff; }
    :global(body) { padding-bottom: 3.4rem; }
  }
</style>
