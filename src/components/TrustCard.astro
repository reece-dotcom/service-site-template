---
/**
 * "Trusted by" card under the hero: real accreditation logos plus the Google
 * rating. Logos are only shown for bodies the client is actually a member of
 * (they come from business.accreditations); anything without a logo on file
 * renders as a text badge. Google line only with a real reviews.aggregate.
 */
import { site } from '../lib/client.mjs';
import { accreditationList } from '../lib/business.mjs';

const LOGOS = [
  { match: /fensa/i, src: '/logos/fensa.jpg', alt: 'FENSA approved installer' },
  { match: /ggf|glass and glazing federation/i, src: '/logos/ggf.png', alt: 'GGF — Glass and Glazing Federation member' },
  { match: /installsure/i, src: '/logos/installsure.jpg', alt: 'Installsure installer insurance' },
];
const items = accreditationList().map((a) => {
  const logo = LOGOS.find((l) => l.match.test(a.name));
  return logo ? { ...a, logo } : a;
});
const agg = site.reviews?.aggregate ?? null;
const show = items.length > 0 || agg;
---
{show && (
  <div class="tc">
    <h3 class="tc__h">Trusted by</h3>
    <div class="tc__press">
      {items.map((a) => a.logo
        ? <img src={a.logo.src} alt={a.logo.alt} loading="eager" />
        : <span class="tc__badge"><span aria-hidden="true">✓</span> {a.name}</span>)}
    </div>
    {agg && items.length > 0 && <span class="tc__divider" aria-hidden="true"></span>}
    {agg && (
      <p class="tc__review">
        <img src="/logos/google.png" alt="" />
        <span><b>{agg.source ?? 'Google'}</b> · {agg.ratingValue} from {agg.reviewCount} reviews</span>
      </p>
    )}
  </div>
)}
<style>
  .tc { position: relative; z-index: 2; width: min(62.5rem, 100% - 2.5rem); margin: 0.9rem auto 0; background: #fff; color: var(--ink); border-radius: var(--radius-panel); padding: 1rem 1.6rem; box-shadow: 0 24px 60px rgb(0 0 0 / 30%); display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .tc__h { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .tc__press { display: flex; flex-wrap: wrap; align-items: center; gap: 2rem; }
  .tc__press img { height: 2.1rem; width: auto; }
  .tc__badge { font-weight: 600; font-size: 0.92rem; }
  .tc__badge span { color: var(--brand); }
  .tc__divider { width: 1px; align-self: stretch; background: var(--hairline); }
  .tc__review { display: flex; align-items: center; gap: 0.6rem; font-size: 0.9rem; color: var(--muted); margin: 0; }
  .tc__review img { height: 1.5rem; width: auto; }
  .tc__review b { color: var(--ink); }
  @media (max-width: 54rem) { .tc { justify-content: center; text-align: center; } .tc__divider { display: none; } .tc__press { justify-content: center; } }
</style>
