---
/**
 * Landing-page layout: deliberately NOT BaseLayout.
 *
 * Paid traffic arrives with one job to do, so the page has no nav, no footer
 * sitemap and no links away except the phone and the form. It is noindex —
 * an ad landing page competing with the real home page for the same terms is
 * a self-inflicted duplicate-content problem.
 */
import '../styles/global.css';
import '../styles/lp.css';
import { site } from '../lib/client.mjs';
import { derivedVars } from '../lib/theme.mjs';
import { assertSeo, canonical } from '../lib/seo.mjs';
import { lpAnnounce, lpConfig } from '../lib/lp.mjs';

const announce = lpAnnounce();
const lp = lpConfig();
const dark = lp.heroLayout === 'centered';
/* Opt-out, not opt-in: every client wants a tappable phone number on mobile. */
const sticky = lp.stickyBar !== false;

const { title, description } = Astro.props;

assertSeo(title, description, Astro.url.pathname);

const url = canonical(Astro.url.pathname);
const t = site.theme;
const dv = Object.entries(derivedVars(t)).map(([k, v]) => `${k}:${v};`).join('');
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="robots" content="noindex, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="en_GB" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={t.brand} />

    <style is:inline set:html={`:root{
      --brand:${t.brand};--brand-dark:${t.brandDark};--accent:${t.accent};--accent-ink:${t.accentInk ?? t.ink};${dv}
      --ink:${t.ink};--muted:${t.muted};--surface:${t.surface};
      --font-heading:${t.fontHeading};--font-body:${t.fontBody};}`}></style>

    {site.analytics.plausibleDomain && (
      <script
        defer
        data-domain={site.analytics.plausibleDomain}
        src="https://plausible.io/js/script.js"
      ></script>
    )}
  </head>
  <body class="lp">
    <a class="skip-link" href="#quote">Skip to the quote form</a>
    {announce && (
      <div class="lp-announce">
        <div class="lp-wrap">
          <p>{announce.text}</p>
          {announce.basis && <p class="lp-announce__basis">{announce.basis}</p>}
        </div>
      </div>
    )}
    <header class={`lp-bar${dark ? ' lp-bar--dark' : ''}`}>
      <div class="lp-wrap lp-bar__inner">
        <span class="lp-bar__name">{site.business.name}</span>
        <a class="btn btn--accent lp-bar__cta" href={`tel:${site.contact.phoneHref}`}>
          Call {site.contact.phone}
        </a>
      </div>
    </header>
    <main><slot /></main>
    {sticky && (
      /* Sticky mobile action bar: most ad traffic here is a phone, and the
         header CTA scrolls away. Hidden on desktop, where the header stays. */
      <div class="lp-sticky">
        <a class="lp-sticky__call" href={`tel:${site.contact.phoneHref}`}>Call {site.contact.phone}</a>
        <a class="lp-sticky__quote" href="#quote">{lp.stickyCta ?? 'Get a fixed price'}</a>
      </div>
    )}
    <footer class="lp-foot">
      <div class="lp-wrap">
        <p>
          &copy; {new Date().getFullYear()} {site.business.legalName ?? site.business.name}
          {site.contact.address?.locality ? ` · ${site.contact.address.locality}` : ''}
          {` · ${site.contact.phone}`}
        </p>
        <p class="lp-foot__note">
          This page is for visitors arriving from our adverts. Everything on it
          is confirmed in writing before any work starts.
        </p>
      </div>
    </footer>
  </body>
</html>
