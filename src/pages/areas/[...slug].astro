---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config.mjs';

export async function getStaticPaths() {
  const items = await getCollection('areas');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const graph = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `${site.brand} in ${d.areaName}`,
    description: d.description,
    provider: { '@id': `${site.url}/#business` },
    areaServed: d.areaName,
  },
];
---
<Base title={d.title} description={d.description} noindex={d.noindex} schema={graph}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-4xl">{d.h1}</h1>

    <blockquote class="mt-6 rounded border-l-4 border-[--color-accent] bg-[--color-surface] p-4 text-lg text-[--color-ink]">
      {d.localProof}
    </blockquote>

    <div class="prose mt-8"><Content /></div>

    <a href={`tel:${site.nap.phone}`} class="mt-12 inline-block rounded bg-[--color-accent] px-6 py-3 text-white">
      Call {site.nap.phoneDisplay}
    </a>
  </article>
</Base>
