---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { canonical, blogPostingSchema, breadcrumbSchema } from '../../lib/seo.mjs';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const related = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.id !== entry.id && p.data.category === entry.data.category)
  .sort((a, b) => b.data.publishedAt - a.data.publishedAt)
  .slice(0, 3);

const url = canonical(`/blog/${entry.id}/`);
const schema = blogPostingSchema({
  headline: entry.data.heading,
  description: entry.data.description,
  url,
  published: entry.data.publishedAt,
  updated: entry.data.updatedAt,
  author: entry.data.author,
});
const fmt = (d) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title={entry.data.title} description={entry.data.description} schemas={[schema, breadcrumbSchema([{ name: 'Advice', path: '/blog/' }, { name: entry.data.heading }])]}>
  <article>
    <header class="section head">
      <div class="container">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true">/</span> <a href="/blog/">Advice</a>
        </nav>
        <p class="eyebrow">{entry.data.category}</p>
        <h1>{entry.data.heading}</h1>
        <p class="meta">
          By {entry.data.author} ·
          <time datetime={entry.data.publishedAt.toISOString()}>{fmt(entry.data.publishedAt)}</time>
          {entry.data.updatedAt && <span> · updated {fmt(entry.data.updatedAt)}</span>}
        </p>
      </div>
    </header>
    <div class="section">
      <div class="container prose"><Content /></div>
    </div>
  </article>
  {related.length > 0 && (
    <section class="section section--surface">
      <div class="container">
        <h2>More on {entry.data.category.toLowerCase()}</h2>
        <div class="grid grid--3 rel">
          {related.map((p) => (
            <article class="card">
              <h3 class="rel__h"><a href={`/blog/${p.id}/`}>{p.data.heading}</a></h3>
              <p class="muted">{p.data.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
  <CtaBand />
</BaseLayout>
<style>
  .head { padding-bottom: 0; }
  .crumb { font-size: 0.9rem; color: var(--muted); margin-bottom: var(--space-6); }
  .crumb a { color: var(--muted); }
  .meta { margin-top: var(--space-6); color: var(--muted); font-size: 0.95rem; }
  .rel { margin-top: var(--space-8); }
  .rel__h { font-size: 1.1rem; margin-bottom: var(--space-2); }
  .rel__h a { text-decoration: none; color: var(--ink); }
</style>
