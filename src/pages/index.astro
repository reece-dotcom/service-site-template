---
/**
 * HOME PAGE = the Glazing Master Template, verbatim. All assembly happens in
 * src/lib/template-home.mjs; this page only renders the result.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/template.css';
import { buildHome } from '../lib/template-home.mjs';
const { html, title, description, schemas } = await buildHome();
---

<BaseLayout title={title} description={description} schemas={schemas} chrome={false}>
  <Fragment set:html={html} />
</BaseLayout>
