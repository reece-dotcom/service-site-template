---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { site } from '../lib/client.mjs';
import { canonical, serviceSchema } from '../lib/seo.mjs';

const services = (await getCollection('services'))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const areas = (await getCollection('areas')).filter((a) => !a.data.draft);

const title = `${site.business.name} | Windows & Doors in ${site.contact.address.locality}`;
const description = site.business.description.slice(0, 160);
const schemas = services.map((s) =>
  serviceSchema({
    name: s.data.name,
    description: s.data.summary,
    url: canonical(`/services/${s.id}/`),
  })
);

/**
 * Hero selling points. Set `business.usps` per client to override — the
 * defaults assume a replacement installer with accreditations, which is wrong
 * for repair-only businesses and produces broken copy when accreditations is
 * empty.
 */
const heroPoints = site.business.usps?.length
  ? site.business.usps
  : [
      'Fixed written quotes after a proper survey — no pressure selling',
      'Fitted by our own installers, never subcontracted',
      ...(site.business.accreditations[0]
        ? [`${site.business.accreditations[0]} with insurance-backed guarantees`]
        : []),
      `Local team covering ${areas.map((a) => a.data.name).slice(0, 3).join(', ')} and nearby`,
    ];
---

<BaseLayout title={title.slice(0, 60)} description={description} schemas={schemas}>
  <section class="hero">
    <div class="container hero__inner">
      <div>
        <p class="eyebrow">{site.contact.address.region}</p>
        <h1>{site.business.tagline}</h1>
        <p class="lede hero__lede">{site.business.description}</p>
        <div class="hero__actions">
          <a class="btn btn--accent" href={`tel:${site.contact.phoneHref}`}>
            Call {site.contact.phone}
          </a>
          <a class="btn btn--ghost hero__ghost" href="/contact/">Book a free survey</a>
        </div>
      </div>
      <ul class="checklist hero__points">
        {heroPoints.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  </section>

  <TrustStrip />

  <section class="section">
    <div class="container">
      <p class="eyebrow">What we fit</p>
      <h2>Our services</h2>
      <div class="grid grid--3 svc">
        {services.map((s) => (
          <article class="card">
            <h3><a href={`/services/${s.id}/`}>{s.data.name}</a></h3>
            <p class="muted">{s.data.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <p class="eyebrow">Where we work</p>
      <h2>Areas we cover</h2>
      <p class="lede">
        Based in {site.contact.address.locality}, working across {site.contact.address.region}.
      </p>
      <ul class="areas">
        {areas.map((a) => (
          <li><a class="btn btn--ghost areas__btn" href={`/areas/${a.id}/`}>{a.data.name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .hero { padding-block: clamp(var(--space-12), 6vw, var(--space-24)); }
  .hero__inner { display: grid; gap: var(--space-12); grid-template-columns: 1.15fr 0.85fr; align-items: center; }
  .hero__lede { margin-top: var(--space-6); }
  .hero__actions { display: flex; gap: var(--space-4); margin-top: var(--space-8); flex-wrap: wrap; }
  .hero__points { background: var(--surface); padding: var(--space-8); border-radius: var(--radius-lg); }
  .svc { margin-top: var(--space-8); }
  .svc h3 a { text-decoration: none; color: var(--ink); }
  .svc h3 a:hover { color: var(--brand); }
  .areas { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }
  .areas__btn { background: #fff; padding: 0.6rem 1.2rem; font-size: 0.98rem; text-decoration: none; }
  @media (max-width: 52rem) { .hero__inner { grid-template-columns: 1fr; } }
</style>
