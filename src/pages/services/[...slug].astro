---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqList from '../../components/FaqList.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import AnswerBlock from '../../components/AnswerBlock.astro';
import { site } from '../../lib/client.mjs';
import { canonical, serviceSchema, faqSchema, breadcrumbSchema } from '../../lib/seo.mjs';
import { copy } from '../../lib/copy.mjs';

export async function getStaticPaths() {
  const services = (await getCollection('services')).filter((s) => !s.data.draft);
  return services.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const areas = (await getCollection('areas')).filter((a) => !a.data.draft);
// Sibling services, in order, wrapping round from this one. Distributes
// authority sideways instead of dead-ending every service page.
const allServices = (await getCollection('services'))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const idx = allServices.findIndex((s) => s.id === entry.id);
const related = [...allServices.slice(idx + 1), ...allServices.slice(0, idx)].slice(0, 3);
const reviewed = entry.data.updatedAt;
const url = canonical(`/services/${entry.id}/`);
const schemas = [
  serviceSchema({ name: entry.data.name, description: entry.data.summary, url }),
  faqSchema(entry.data.faqs),
  breadcrumbSchema([
    { name: 'Services', path: '/services/' },
    { name: entry.data.name },
  ]),
];
---
<BaseLayout title={entry.data.title} description={entry.data.description} schemas={schemas}>
  <section class="section">
    <div class="container">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span> <a href="/services/">Services</a>
      </nav>
      <p class="eyebrow">{site.contact.address.region}</p>
      <h1>{entry.data.heading}</h1>
      <p class="lede">{entry.data.summary}</p>
      {entry.data.benefits.length > 0 && (
        <ul class="checklist benefits">
          {entry.data.benefits.map((b) => <li>{b}</li>)}
        </ul>
      )}
      {entry.data.answer && (
        <div class="answer-wrap">
          <AnswerBlock
            question={entry.data.answerQuestion ??
              `${entry.data.name} in ${site.contact.address.locality} — the short answer`}
            answer={entry.data.answer}
          />
        </div>
      )}
    </div>
  </section>
  <TrustStrip />
  <section class="section">
    <div class="container prose"><Content /></div>
  </section>
  <FaqList faqs={entry.data.faqs} />
  <section class="section">
    <div class="container">
      <h2>{copy('serviceAreasHeading', { service: entry.data.name })}</h2>
      <ul class="areas">
        {areas.map((a) => {
          // Deep-link to the service x area page when that town has one: it is
          // the page built to rank for "<service> <town>", so the anchor text
          // and the destination should agree.
          const hasDetail = a.data.serviceDetail.some((d) => d.service === entry.id);
          return (
            <li>
              <a href={hasDetail ? `/services/${entry.id}/in/${a.id}/` : `/areas/${a.id}/`}>
                {entry.data.name} in {a.data.name}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
  {related.length > 0 && (
    <section class="section section--tint">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">While we are there</p>
            <h2>Other work we take on</h2>
          </div>
        </div>
        <ul class="rel">
          {related.map((r) => (
            <li>
              <a class="card card--link rel__card" href={`/services/${r.id}/`}>
                <h3>{r.data.name}</h3>
                <p>{r.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
  {reviewed && (
    <p class="container reviewed">
      <small>
        Last reviewed
        <time datetime={reviewed.toISOString().slice(0, 10)}>
          {reviewed.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
      </small>
    </p>
  )}
  <CtaBand heading={`Thinking about ${entry.data.name.toLowerCase()}?`} />
</BaseLayout>
<style>
  .crumb { font-size: 0.9rem; color: var(--muted); margin-bottom: var(--space-6); }
  .crumb a { color: var(--muted); }
  .answer-wrap { margin-top: var(--space-8); }
  .benefits { margin-top: var(--space-8); max-width: 60ch; }
  .section--tint { background: var(--surface); }
  .rel { list-style: none; padding: 0; display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); }
  .rel__card { display: block; text-decoration: none; }
  .rel__card h3, .rel__card p { text-decoration: none; }
  .rel__card h3 { font-size: 1.15rem; }
  .rel__card p { color: var(--muted); margin-top: var(--space-2); }
  .reviewed { color: var(--muted); margin-top: var(--space-10); }
  .reviewed time { margin-left: 0.35rem; }
  .areas { list-style: none; padding: 0; display: grid; gap: var(--space-3); margin-top: var(--space-6); grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); }
</style>
