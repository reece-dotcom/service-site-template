---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../lib/client.mjs';
import { copy } from '../../lib/copy.mjs';
const services = (await getCollection('services')).filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const loc = site.contact.address.locality;
---
<BaseLayout
  title={`Windows, Doors & Glazing Services | ${loc}`.slice(0, 60)}
  description={copy('servicesDescription').slice(0, 160)}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Services</p>
      <h1>{copy('servicesHeading')}</h1>
      <p class="lede">{copy('servicesLede')}</p>
      <div class="grid grid--3 list">
        {services.map((s) => (
          <article class="card">
            <h2 class="list__h"><a href={`/services/${s.id}/`}>{s.data.name}</a></h2>
            <p class="muted">{s.data.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
<style>
  .list { margin-top: var(--space-8); }
  .list__h { font-size: 1.25rem; margin-bottom: var(--space-2); }
  .list__h a { text-decoration: none; color: var(--ink); }
  .list__h a:hover { color: var(--brand); }
</style>
